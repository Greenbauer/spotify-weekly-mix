# Spotify developer app (https://developer.spotify.com/dashboard)
# Dev Mode in 2026 requires the app owner to have Spotify Premium.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Headless auth: a refresh token minted once with the scopes in the README.
# Do not commit this file. mix.py never starts OAuth by itself.
SPOTIFY_REFRESH_TOKEN=

# Optional: a still-valid access token. If set, refresh is skipped until 401.
# SPOTIFY_ACCESS_TOKEN=

# Similar artists: MusicBrainz + ListenBrainz. No API key.
# Popular tracks: Spotify search (and /artists/{id}/top-tracks if this app
# still has it). Last.fm is not used.

# Mix knobs
MIX_PLAYLIST_NAME=Weekly Mix
MIX_SIZE=40
MIX_MIN_POPULARITY=55
MIX_MAX_PER_ARTIST=2
# 1 = also seed artists from Liked Songs (likes are NEVER in the output pool)
MIX_USE_LIKES=1
# Primary artist must appear at least this many times across seed playlists
# (and likes, if enabled). One-off remix credits do not dominate. Default 2.
MIX_MIN_SEED_COUNT=2
# Max Path C search-rank guesses when real Spotify popularity tracks exist.
# A guess-only mix (Dev Mode, no popularity field) ignores this and fills
# to MIX_SIZE. Default 10.
MIX_MAX_PATH_C=10
# Minutes a heard mix track stays on the playlist before roll_playlist removes it
MIX_ROLL_DELAY_MIN=5
